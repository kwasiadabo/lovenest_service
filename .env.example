NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=changeme
DB_NAME=vx_school_dev
DB_NAME_TEST=vx_school_test
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts per-school SMS/email credentials (School.emailAppPasswordEncrypted)
# at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes every previously-encrypted value
# undecryptable, so treat it like any other production secret.
CREDENTIALS_ENCRYPTION_KEY=

# Paystack secret key (test or live) — required for the billing/subscription flow
PAYSTACK_SECRET_KEY=

# Cloudinary — used for student photo storage. Get this from
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Nalo Solutions — one shared platform account for ALL schools' SMS. Each
# school's displayed Sender ID (and its own Gmail sending account) is
# configured per-tenant instead (School.smsSenderId/emailUser/
# emailAppPasswordEncrypted, editable via Settings) — not an env var.
NALO_API_KEY=
NALO_ENDPOINT=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/

# Platform-level reminder/reactivation contact — used ONLY by the daily
# subscription-reminder cron (modules/billing/reminderService.js) to reach a
# school's own registered contact (School.phone/School.email) on the
# platform's behalf. Deliberately separate from the tenant's own
# smsSenderId/emailUser above: a pending/trial/suspended school may not have
# configured those yet, and this is the platform reaching out, not the
# tenant messaging its own parents.
PLATFORM_SMS_SENDER_ID=
PLATFORM_EMAIL_USER=
PLATFORM_EMAIL_APP_PASSWORD=
