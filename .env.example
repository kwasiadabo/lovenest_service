NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Dedicated database for this deployment — serves Lovenest International
# Christian School only, not shared with any other tenant.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=changeme
DB_NAME=lovenest_db
DB_NAME_TEST=lovenest_db_test
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts per-school SMS/email credentials (School.emailAppPasswordEncrypted)
# at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes every previously-encrypted value
# undecryptable, so treat it like any other production secret.
CREDENTIALS_ENCRYPTION_KEY=

# Paystack secret key (test or live) — required for parents paying school
# fees online (modules/parentPortal/service.js)
PAYSTACK_SECRET_KEY=

# Cloudinary — used for student photo and school logo storage. Get this from
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Nalo Solutions — one shared platform account for ALL schools' SMS. Each
# school's displayed Sender ID (and its own Gmail sending account) is
# configured per-tenant instead (School.smsSenderId/emailUser/
# emailAppPasswordEncrypted, editable via Settings) — not an env var.
NALO_API_KEY=
NALO_ENDPOINT=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/

# Used once by the seeders/20260101000002-lovenest-school.js seeder to create
# Lovenest's own School row and its first SCHOOL_ADMIN account. All optional
# — sensible defaults are baked into the seeder; LOVENEST_ADMIN_PASSWORD in
# particular should be overridden before seeding a real environment (the
# seeded account has forcePasswordChange set, but don't rely on that alone).
LOVENEST_SCHOOL_ADDRESS=
LOVENEST_SCHOOL_PHONE=
LOVENEST_SCHOOL_EMAIL=
LOVENEST_STUDENT_POPULATION=
LOVENEST_ACADEMIC_YEAR_NAME=
LOVENEST_ACADEMIC_YEAR_START=
LOVENEST_ACADEMIC_YEAR_END=
LOVENEST_TERM_START=
LOVENEST_TERM_END=
LOVENEST_ADMIN_NAME=
LOVENEST_ADMIN_EMAIL=
LOVENEST_ADMIN_PASSWORD=
